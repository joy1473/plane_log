{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "lsa.joy.it.kr" }],
      "destination": "/hub",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/hub", "destination": "/hub/index.html" },
    { "source": "/lsa", "destination": "/lsa/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
